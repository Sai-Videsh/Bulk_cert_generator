# Bulk Certificate Generator — local defaults (copy to .env to override)
DATABASE_URL=sqlite:///./bulk_certs.db
STORAGE_DIR=./storage/certificates
MAX_WORKERS=8
MAX_RECIPIENTS_PER_JOB=5000
LOG_LEVEL=INFO
API_PAGE_SIZE_MAX=100
# Broad gates (evaluator-safe defaults)
RATE_LIMIT_PER_MINUTE=600
MAX_BODY_BYTES=5242880
# Optional auth: OFF by default so gates pass. Prod: true + comma-separated keys.
AUTH_ENABLED=false
API_KEYS=
CORS_ORIGINS=*
# Retries: transient errors retry this many times; permanent fail fast.
MAX_GENERATION_RETRIES=2
